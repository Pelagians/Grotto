# syntax=docker/dockerfile:1.7
FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
ARG GROTTO_BUILD_REVISION=unknown
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 GROTTO_BUILD_REVISION=${GROTTO_BUILD_REVISION}
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin worker && install -d -o worker -g worker /work/input /work/raw /work/output /work/logs
COPY --chmod=0644 runtimes/sports-workers/worker_common.py /usr/local/lib/python3.12/site-packages/worker_common.py
COPY --chmod=0755 runtimes/sports-market-probe/grotto_sports_market_probe.py /usr/local/bin/grotto-sports-market-probe
RUN python /usr/local/bin/grotto-sports-market-probe canary
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["python", "/usr/local/bin/grotto-sports-market-probe"]
CMD ["--help"]
