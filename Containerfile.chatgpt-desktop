# syntax=docker/dockerfile:1.7

# OpenAI's official ChatGPT Desktop package for Linux. Grotto pins one exact
# pool artifact per architecture instead of tracking the vendor "latest" alias
# so an image rebuild always installs the same application bytes.
ARG CHATGPT_PACKAGE_VERSION=26.820.60940
ARG CHATGPT_PACKAGE_SHA256_AMD64=31d956a8c6c515f8d87e0b7acd9ec919f7e685ba59331b4b97aa45f853afdfd7
ARG CHATGPT_PACKAGE_SHA256_ARM64=8f4dacbff5f054a4f69c2a021f1396c57976972829a61041febac1b423f27c86
ARG CHATGPT_PACKAGE_BASE_URL=https://persistent.oaistatic.com/codex-app-prod/linux/deb
ARG SELKIES_BASE_IMAGE=ghcr.io/linuxserver/baseimage-selkies:debiantrixie@sha256:ac7fd6d182238b4a99e66554c5e75be48a714e2a0c9da81bd18e171ff9ba3dd5
ARG GROTTO_BUILD_REVISION=unknown

FROM ${SELKIES_BASE_IMAGE}

ARG CHATGPT_PACKAGE_VERSION
ARG CHATGPT_PACKAGE_SHA256_AMD64
ARG CHATGPT_PACKAGE_SHA256_ARM64
ARG CHATGPT_PACKAGE_BASE_URL
ARG SELKIES_BASE_IMAGE
ARG GROTTO_BUILD_REVISION

LABEL io.pelagians.grotto.chatgpt-package-version="$CHATGPT_PACKAGE_VERSION" \
      io.pelagians.grotto.chatgpt-package-source="$CHATGPT_PACKAGE_BASE_URL" \
      io.pelagians.grotto.selkies-base-image="$SELKIES_BASE_IMAGE" \
      org.opencontainers.image.revision="$GROTTO_BUILD_REVISION"

# LinuxServer installs the Selkies backend in /lsiopy. Keep that venv on PATH;
# its s6 service invokes the bare `selkies` command during container startup.
#
# The vendor package ships its own Codex CLI and Node runtime under
# /usr/lib/chatgpt/resources, so Grotto no longer installs either separately.
ENV TITLE="ChatGPT Desktop" \
    START_DOCKER=false \
    PIXELFLUX_WAYLAND=true \
    AUTO_GPU=true \
    RESTART_APP=true \
    FILE_MANAGER_PATH=/workspace \
    GROTTO_RUNTIME=chatgpt-desktop \
    GROTTO_CHATGPT_AUTH_MODE=device \
    GROTTO_BUILD_REVISION="$GROTTO_BUILD_REVISION" \
    GROTTO_CHATGPT_PACKAGE_VERSION="$CHATGPT_PACKAGE_VERSION" \
    GROTTO_SELKIES_BASE_IMAGE="$SELKIES_BASE_IMAGE" \
    GROTTO_CHATGPT_WM_CLASS=chatgpt-desktop \
    CODEX_HOME=/config/.codex \
    CODEX_CLI_PATH=/usr/lib/chatgpt/resources/codex \
    CODEX_MANAGED_NODE_RUNTIME_DIR=/usr/lib/chatgpt/resources/cua_node \
    XDG_CONFIG_HOME=/config/.config \
    XDG_CACHE_HOME=/config/.cache \
    XDG_STATE_HOME=/config/.local/state \
    CODEX_FORCE_DEVICE_SCALE_FACTOR=1 \
    CARGO_HOME=/tools/cargo \
    MISE_DATA_DIR=/tools/mise \
    NPM_CONFIG_CACHE=/cache/npm \
    NPM_CONFIG_PREFIX=/tools/npm \
    PIP_CACHE_DIR=/cache/pip \
    PIPX_BIN_DIR=/tools/bin \
    PIPX_HOME=/tools/pipx \
    PNPM_HOME=/tools/pnpm \
    PYTHONUSERBASE=/tools/python \
    UV_CACHE_DIR=/cache/uv \
    PATH=/tools/bin:/tools/npm/bin:/tools/pnpm:/tools/cargo/bin:/tools/mise/shims:/usr/lib/chatgpt/resources/cua_node/bin:/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

COPY runtimes/chatgpt-desktop/verify-installed-policy.py \
    /usr/local/libexec/grotto-verify-installed-chatgpt-policy

# Grotto's own tooling plus the workspace commands the runtime smoke test
# asserts. The ChatGPT package declares its complete Electron dependency set,
# so those libraries are resolved by apt when the package is installed below
# instead of being restated here.
#
# bubblewrap replaces the helper the npm Codex CLI used to vendor: the native
# package ships no bwrap, and grotto-doctor reports the sandbox backend Codex
# will actually use.
RUN set -eux; \
    apt-get update -o Acquire::Retries=5; \
    apt-get install --no-install-recommends -y \
        at-spi2-core \
        bash \
        bubblewrap \
        ca-certificates \
        curl \
        findutils \
        gh \
        git \
        jq \
        gir1.2-gdkpixbuf-2.0 \
        gir1.2-gtk-3.0 \
        libsecret-1-0 \
        lsof \
        pkg-config \
        python3 \
        python3-cairo \
        python3-gi \
        python3-pip \
        qrencode \
        ripgrep \
        shellcheck \
        sqlite3 \
        unzip \
        xdg-utils \
        zip; \
    rm -rf /var/lib/apt/lists/*

# Install the pinned vendor package. The archive is fetched by exact pool path
# and checked against the digest published in the repository index, so the build
# fails instead of silently installing a different application build.
#
# The package's postinst adds OpenAI's apt source unless repo_add_once is
# already false. Seed that opt-out first: the image must stay on the pinned
# version rather than drifting on the next `apt-get upgrade` inside a container.
RUN set -eux; \
    package_arch="$(dpkg --print-architecture)"; \
    case "$package_arch" in \
        amd64) package_sha256="${CHATGPT_PACKAGE_SHA256_AMD64}" ;; \
        arm64) package_sha256="${CHATGPT_PACKAGE_SHA256_ARM64}" ;; \
        *) echo "Unsupported build architecture: $package_arch" >&2; exit 1 ;; \
    esac; \
    package_name="chatgpt_${CHATGPT_PACKAGE_VERSION}_${package_arch}.deb"; \
    install -d -m 0755 /etc/default; \
    printf '%s\n' 'repo_add_once="false"' > /etc/default/chatgpt; \
    chmod 0644 /etc/default/chatgpt; \
    curl -fsSL \
        "${CHATGPT_PACKAGE_BASE_URL}/pool/main/c/chatgpt/${package_name}" \
        -o "/tmp/${package_name}"; \
    printf '%s  %s\n' "$package_sha256" "/tmp/${package_name}" | sha256sum -c -; \
    apt-get update -o Acquire::Retries=5; \
    apt-get install --no-install-recommends -y "/tmp/${package_name}"; \
    rm -f "/tmp/${package_name}"; \
    rm -rf /var/lib/apt/lists/*; \
    test ! -e /etc/apt/sources.list.d/chatgpt.sources; \
    test "$(dpkg-query --show --showformat='${Version}' chatgpt)" = "${CHATGPT_PACKAGE_VERSION}"; \
    test -x /usr/lib/chatgpt/ChatGPT; \
    test -x /usr/bin/chatgpt; \
    test -x /usr/lib/chatgpt/resources/codex; \
    test -x /usr/lib/chatgpt/resources/cua_node/bin/node; \
    ln -sf /usr/lib/chatgpt/resources/codex /usr/local/bin/codex; \
    test -x /usr/local/bin/codex

# Record what the installed application exposes. Grotto does not patch the
# vendor package, so this is a provenance and policy statement about the shipped
# bundle rather than a check that a local patch survived an upstream rebuild.
RUN set -eux; \
    install -d -m 0755 /usr/share/grotto; \
    python3 /usr/local/libexec/grotto-verify-installed-chatgpt-policy \
        --root /usr/lib/chatgpt \
        --package-version "${CHATGPT_PACKAGE_VERSION}" \
        --manifest /usr/share/grotto/chatgpt-desktop-security.json; \
    test -s /usr/share/grotto/chatgpt-desktop-security.json; \
    test "$(stat -c '%a' /usr/share/grotto/chatgpt-desktop-security.json)" = 444

# Install Grotto's runtime overlay and self-check it.
#
# XDG_CACHE_HOME and the other XDG variables point into /config, so build-time
# tools that write a cache leave root-owned directories behind there. The
# session launcher runs `install -d` over those paths as `abc` and aborts if it
# cannot chmod them, so this step takes ownership of them and then asserts that
# nothing under /config is owned by anyone else.
COPY runtimes/chatgpt-desktop/root/ /
COPY tests/chatgpt-desktop-runtime.sh /usr/local/libexec/grotto-chatgpt-desktop-smoke
COPY tests/test_grotto_doctor.py /usr/local/libexec/test-grotto-doctor.py
COPY tests/test_window_manager_config.py /usr/local/libexec/test-window-manager-config.py

RUN set -eux; \
    chmod 0755 \
        /defaults/autostart \
        /defaults/autostart_wayland \
        /usr/local/bin/grotto-doctor \
        /usr/local/bin/grotto-chatgpt-auth \
        /usr/local/libexec/grotto-configure-openbox \
        /usr/local/libexec/grotto-chatgpt-desktop-smoke \
        /custom-cont-init.d/10-grotto-chatgpt-permissions; \
    bash -n /defaults/autostart; \
    bash -n /defaults/autostart_wayland; \
    python3 -m py_compile /usr/local/bin/grotto-chatgpt-auth; \
    python3 /usr/local/bin/grotto-chatgpt-auth --self-test; \
    bash -n /custom-cont-init.d/10-grotto-chatgpt-permissions; \
    bash -n /usr/local/libexec/grotto-chatgpt-desktop-smoke; \
    python3 -m py_compile \
        /usr/local/bin/grotto-doctor \
        /usr/local/libexec/grotto-configure-openbox \
        /usr/local/libexec/test-window-manager-config.py \
        /usr/local/libexec/test-grotto-doctor.py; \
    /usr/local/libexec/grotto-configure-openbox /etc/xdg/openbox/rc.xml; \
    GROTTO_OPENBOX_CONFIG=/etc/xdg/openbox/rc.xml \
    GROTTO_LABWC_CONFIG=/defaults/labwc.xml \
    GROTTO_WINDOW_CONFIGURATOR=/usr/local/libexec/grotto-configure-openbox \
        python3 /usr/local/libexec/test-window-manager-config.py \
            --installed-image; \
    GROTTO_DOCTOR_UNDER_TEST=/usr/local/bin/grotto-doctor \
        python3 /usr/local/libexec/test-grotto-doctor.py; \
    rm -f \
        /usr/local/libexec/test-grotto-doctor.py \
        /usr/local/libexec/test-window-manager-config.py; \
    rm -rf /usr/local/bin/__pycache__ /usr/local/libexec/__pycache__; \
    shellcheck \
        /defaults/autostart \
        /custom-cont-init.d/10-grotto-chatgpt-permissions \
        /usr/local/libexec/grotto-chatgpt-desktop-smoke; \
    for command_name in \
        bash bwrap chatgpt codex curl find gh git jq lsof node npm pip3 \
        pkg-config python3 rg shellcheck sqlite3 unzip zip; \
    do \
        command -v "$command_name"; \
    done; \
    python3 -c 'import gi; gi.require_version("Gtk", "3.0"); gi.require_version("GdkPixbuf", "2.0"); from gi.repository import GdkPixbuf, Gtk'; \
    command -v qrencode; \
    install -d -o abc -g abc -m 0755 \
        /config \
        /config/.cache \
        /config/.config \
        /config/.local \
        /config/.local/state \
        /workspace \
        /tools \
        /tools/bin \
        /tools/cargo \
        /tools/mise \
        /tools/npm \
        /tools/pnpm \
        /tools/python \
        /tools/pipx \
        /tools/venvs \
        /cache \
        /cache/npm \
        /cache/pip \
        /cache/uv; \
    test "$(stat -c '%U:%G:%a' /config)" = 'abc:abc:755'; \
    test -z "$(find /config ! -user abc -print -quit)"; \
    if [ -f /usr/lib/chatgpt/resources/icon-chatgpt.png ]; then \
        install -m 0644 \
            /usr/lib/chatgpt/resources/icon-chatgpt.png \
            /usr/share/selkies/www/icon.png; \
    fi; \
    test -x /lsiopy/bin/selkies; \
    test "$(command -v selkies)" = /lsiopy/bin/selkies; \
    test -r /usr/share/grotto/chatgpt-desktop-security.json; \
    test "$(stat -c '%a' /usr/share/grotto/chatgpt-desktop-security.json)" = 444; \
    env -i HOME=/tmp PATH=/usr/bin:/bin \
        /usr/lib/chatgpt/resources/codex --version

WORKDIR /workspace

EXPOSE 3001

VOLUME ["/config", "/workspace", "/tools", "/cache"]
