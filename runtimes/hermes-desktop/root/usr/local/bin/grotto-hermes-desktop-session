#!/bin/bash
set -Eeuo pipefail

export HOME=/config
export HERMES_DESKTOP_USER_DATA_DIR="${HERMES_DESKTOP_USER_DATA_DIR:-/config/hermes-desktop}"
export HERMES_DESKTOP_PASSWORD_STORE="${HERMES_DESKTOP_PASSWORD_STORE:-gnome-libsecret}"
export XDG_CONFIG_HOME=/config/.config
export XDG_DATA_HOME=/config/.local/share
export XDG_STATE_HOME=/config/.local/state
export XDG_CACHE_HOME=/cache/xdg

umask 077
mkdir -p "$HERMES_DESKTOP_USER_DATA_DIR"
session_log="$HERMES_DESKTOP_USER_DATA_DIR/session.log"
: >> "$session_log"
chmod 0600 "$session_log"
exec >> "$session_log" 2>&1
printf '[grotto-hermes-desktop] starting session\n'

if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    dbus_environment="$(dbus-launch --sh-syntax)"
    eval "$dbus_environment"
    unset dbus_environment
fi

if [[ -z "${GROTTO_HERMES_DESKTOP_KEYRING_PASSWORD:-}" ]]; then
    echo "grotto-hermes-desktop: GROTTO_HERMES_DESKTOP_KEYRING_PASSWORD is required" >&2
    exit 2
fi

keyring_environment="$(
    printf '%s\n' "$GROTTO_HERMES_DESKTOP_KEYRING_PASSWORD" |
        gnome-keyring-daemon --unlock --components=secrets
)"
eval "$keyring_environment"
unset GROTTO_HERMES_DESKTOP_KEYRING_PASSWORD keyring_environment

cd /workspace
printf '[grotto-hermes-desktop] launching Hermes Desktop\n'
exec /usr/local/bin/hermes-desktop \
    --no-sandbox \
    --enable-features=UseOzonePlatform \
    --disable-features=CustomTitlebar,WaylandWindowDecorations \
    --ozone-platform=wayland
