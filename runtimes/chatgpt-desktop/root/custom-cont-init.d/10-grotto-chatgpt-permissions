#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -Eeuo pipefail

# LinuxServer adjusts the abc account to PUID/PGID before custom init scripts run.
# Keep Codex credentials owned by the same account that launches the desktop app.
#
# The XDG roots below live under /config as well. Persistent state carried over
# from an older image can hold root-owned copies of them, which the session
# launcher cannot chmod, so repair them here while this script still runs as root.
install -d -o abc -g abc -m 0700 /config/.codex
install -d -o abc -g abc -m 0755 \
    /config/.cache \
    /config/.config \
    /config/.config/labwc \
    /config/.config/openbox \
    /config/.local \
    /config/.local/state \
    /workspace \
    /tools \
    /tools/bin \
    /tools/cargo \
    /tools/mise \
    /tools/npm \
    /tools/pnpm \
    /tools/python \
    /tools/pipx \
    /tools/venvs \
    /cache \
    /cache/npm \
    /cache/pip \
    /cache/uv \
    /cache/xdg

# The Selkies base only seeds window-manager files when persistent state does
# not already contain them. Refresh Grotto's launchers and window policy on
# every start so an existing /config volume cannot keep the base terminal
# launcher, LinuxServer's catch-all maximization, or a superseded policy after
# an image update. The base locks the active autostart copy read-only later
# when RESTART_APP is enabled.
install -o abc -g abc -m 0755 \
    /defaults/autostart \
    /config/.config/openbox/autostart
install -o abc -g abc -m 0755 \
    /defaults/autostart_wayland \
    /config/.config/labwc/autostart
install -o abc -g abc -m 0644 \
    /defaults/labwc.xml \
    /config/.config/labwc/rc.xml

# Openbox reads the persistent copy, so the build-time policy in /etc/xdg is
# only a seed. Reapply it here: the configurator is idempotent and edits just
# its own marked block, so unrelated user changes to rc.xml survive.
if [[ ! -f /config/.config/openbox/rc.xml ]]; then
    install -o abc -g abc -m 0644 \
        /etc/xdg/openbox/rc.xml \
        /config/.config/openbox/rc.xml
fi
/usr/local/libexec/grotto-configure-openbox /config/.config/openbox/rc.xml
chown abc:abc /config/.config/openbox/rc.xml

# Repair only the persistent roots and Grotto-managed tool/cache directories.
# Project contents keep their existing ownership so host-side checkouts are not
# recursively rewritten on every container start.
chown abc:abc /workspace /tools /cache
chown abc:abc \
    /tools/bin /tools/cargo /tools/mise /tools/npm /tools/pnpm \
    /tools/python /tools/pipx /tools/venvs \
    /cache/npm /cache/pip /cache/uv /cache/xdg

if [[ -d /config/.codex ]]; then
    chown -R abc:abc /config/.codex
    chmod 0700 /config/.codex
fi

if [[ -f /config/.codex/auth.json ]]; then
    chmod 0600 /config/.codex/auth.json
fi
